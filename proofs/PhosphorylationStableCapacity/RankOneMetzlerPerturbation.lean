module
public import proofs.PhosphorylationStableCapacity.MetzlerLimit

@[expose] public section

namespace PhosphorylationStableCapacity

open Filter
open scoped Topology

noncomputable section

/-- The complementary block produced by a triangular shear of a
final-column-weighted matrix. -/
def rankOneShearComplement {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι ℝ) (u c : ι → ℝ) (τ : ℝ) : Matrix ι ι ℝ :=
  fun i j => A i j - τ * u i * c j

/-- A strict Metzler certificate persists under the finite rank-one
perturbation generated by a sufficiently small final current weight. -/
theorem rankOneShearComplement_eventually_hurwitz
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι ℝ) (u c w : ι → ℝ)
    (hw : ∀ i, 0 < w i)
    (hoff : ∀ i j, i ≠ j → 0 < A i j)
    (hcert : ∀ i, (∑ j, A i j * w j) < 0) :
    ∀ᶠ τ : ℝ in 𝓝 (0 : ℝ),
      IsHurwitz (rankOneShearComplement A u c τ) := by
  apply eventually_hurwitz_of_entrywise_strict_metzler_limit
    (fun τ => rankOneShearComplement A u c τ) A w hw
  · intro i j
    have hcont : Continuous (fun τ : ℝ => A i j - τ * u i * c j) := by
      fun_prop
    simpa [rankOneShearComplement] using hcont.tendsto 0
  · exact hoff
  · exact hcert

end
end PhosphorylationStableCapacity
