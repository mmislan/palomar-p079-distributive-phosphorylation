  exact integer_det_pos_of_triangular_product benchmarkSaddleThreeA.entries
    benchmarkSaddleThreeDetE benchmarkSaddleThreeDetT
    benchmarkSaddleThreeDetE_lower benchmarkSaddleThreeDetT_upper
    benchmarkSaddleThreeDet_product benchmarkSaddleThreeDetE_diagonal_positive
    benchmarkSaddleThreeDetT_diagonal_positive

