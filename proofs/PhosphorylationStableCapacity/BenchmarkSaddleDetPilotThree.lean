private theorem benchmarkSaddleThreeDetE_lower :
    benchmarkSaddleThreeDetE.IsLowerTriangular := by
  intro i j hij
  change i < j at hij
  fin_cases i <;> fin_cases j <;>
    norm_num [benchmarkSaddleThreeDetE] at *

private theorem benchmarkSaddleThreeDetT_upper :
    benchmarkSaddleThreeDetT.IsUpperTriangular := by
  intro i j hij
  change j < i at hij
  fin_cases i <;> fin_cases j <;>
    norm_num [benchmarkSaddleThreeDetT] at *

private theorem benchmarkSaddleThreeDet_product :
    benchmarkSaddleThreeDetE * benchmarkSaddleThreeA.entries =
      benchmarkSaddleThreeDetT := by
  ext i j
  rw [Matrix.mul_apply]
  fin_cases i <;> fin_cases j <;>
    norm_num [benchmarkSaddleThreeDetE, benchmarkSaddleThreeA,
      benchmarkSaddleThreeDetT, Fin.sum_univ_succ]

private theorem benchmarkSaddleThreeDetE_diagonal_positive :
    0 < ∏ i : Fin 9, benchmarkSaddleThreeDetE i i := by
  norm_num [benchmarkSaddleThreeDetE, Fin.prod_univ_succ]

private theorem benchmarkSaddleThreeDetT_diagonal_positive :
    0 < ∏ i : Fin 9, benchmarkSaddleThreeDetT i i := by
  norm_num [benchmarkSaddleThreeDetT, Fin.prod_univ_succ]

