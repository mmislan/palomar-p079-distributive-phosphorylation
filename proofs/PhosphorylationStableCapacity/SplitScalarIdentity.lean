module
public import proofs.PhosphorylationStableCapacity.SplitSlowComplexIsolation

@[expose] public section

namespace PhosphorylationStableCapacity

noncomputable section

open PhosphorylationSharpness Polynomial

/-- The scalar root product generated by the exact split recurrence. -/
def splitScalarProduct : ℕ → ℝ → ℝ → ℝ
  | 0, δ, x => x - splitRoot δ 0
  | m+1, δ, x =>
      (x - splitRoot δ (2*m+1)) *
        (x - splitRoot δ (2*m+2)) * splitScalarProduct m δ x

/-- The inherited recurrence's residual is exactly the complete prescribed
root product, for every splitting parameter and every real argument. -/
theorem splitPair_scalar_identity (m : ℕ) (δ x : ℝ) :
    (x-1)*(splitPair m δ).1.eval (ratio x) -
      2*(splitPair m δ).2.eval (ratio x) =
        splitScalarProduct m δ x := by
  induction m with
  | zero =>
      simp [splitScalarProduct, splitPair, splitRoot]
      ring
  | succ m ih =>
      change (x-1)*(nextN _ _ _ _).eval (ratio x) -
        2*(nextJ _ _ _ _).eval (ratio x) = _
      rw [next_identity, ih]
      rfl

theorem splitScalarProduct_eq_prod_range (m : ℕ) (δ x : ℝ) :
    splitScalarProduct m δ x =
      ∏ j ∈ Finset.range (2*m+1), (x - splitRoot δ j) := by
  induction m with
  | zero => simp [splitScalarProduct]
  | succ m ih =>
      rw [splitScalarProduct, ih]
      have hsize : 2*(m+1)+1 = (2*m+1+1)+1 := by omega
      rw [hsize]
      conv_rhs =>
        rw [Finset.prod_range_succ]
        rw [Finset.prod_range_succ]
      ring

/-- The scalar derivative at a prescribed root is the product of all
remaining root gaps. -/
theorem splitScalarProduct_deriv_at_root (m j : ℕ) (δ : ℝ)
    (hj : j < 2*m+1) :
    deriv (fun x => splitScalarProduct m δ x) (splitRoot δ j) =
      ∏ i ∈ (Finset.range (2*m+1)).erase j,
        (splitRoot δ j - splitRoot δ i) := by
  classical
  have heq : (fun x => splitScalarProduct m δ x) =
      fun x => ∏ i ∈ Finset.range (2*m+1), (x - splitRoot δ i) := by
    funext x
    exact splitScalarProduct_eq_prod_range m δ x
  rw [heq]
  rw [deriv_fun_finsetProd]
  · have hmem : j ∈ Finset.range (2*m+1) := Finset.mem_range.mpr hj
    simp only [deriv_sub_const, deriv_id'', smul_eq_mul, mul_one]
    apply Finset.sum_eq_single j
    · intro i hi hij
      have hje : j ∈ (Finset.range (2*m+1)).erase i :=
        Finset.mem_erase.mpr ⟨Ne.symm hij, hmem⟩
      rw [Finset.prod_eq_zero hje]
      simp
    · intro hnot
      exact (hnot hmem).elim
  · intro i hi
    fun_prop

/-- The monic split residual is positive above its largest prescribed root. -/
theorem splitScalarProduct_pos_above (m : ℕ) {δ x : ℝ}
    (hδ : 0 < δ) (hx : splitRoot δ (2*m) < x) :
    0 < splitScalarProduct m δ x := by
  rw [splitScalarProduct_eq_prod_range]
  apply Finset.prod_pos
  intro i hi
  have hi : i ≤ 2*m := by
    have := Finset.mem_range.mp hi
    omega
  exact sub_pos.mpr (lt_of_le_of_lt ((splitRoot_strictMono hδ).monotone hi) hx)

/-- Adding two larger roots multiplies the derivative at an old root by
two negative gaps, hence by a positive factor. -/
theorem splitScalarProduct_deriv_succ_old (m j : ℕ) (δ : ℝ)
    (hj : j < 2*m+1) :
    deriv (fun x => splitScalarProduct (m+1) δ x) (splitRoot δ j) =
      (splitRoot δ j - splitRoot δ (2*m+1)) *
      (splitRoot δ j - splitRoot δ (2*m+2)) *
      deriv (fun x => splitScalarProduct m δ x) (splitRoot δ j) := by
  let a := splitRoot δ (2*m+1)
  let b := splitRoot δ (2*m+2)
  let r := splitRoot δ j
  have hz : splitScalarProduct m δ r = 0 := by
    rw [splitScalarProduct_eq_prod_range]
    apply Finset.prod_eq_zero (Finset.mem_range.mpr hj)
    simp [r]
  have hd : DifferentiableAt ℝ (fun x => splitScalarProduct m δ x) r := by
    have heq : (fun x => splitScalarProduct m δ x) =
        fun x => ∏ i ∈ Finset.range (2*m+1), (x - splitRoot δ i) := by
      funext x
      exact splitScalarProduct_eq_prod_range m δ x
    rw [heq]
    fun_prop
  change deriv (fun x => ((x-a)*(x-b))*splitScalarProduct m δ x) r = _
  have hfun : (fun x => (x-a)*(x-b)*splitScalarProduct m δ x) =
      (fun x => (x-a)*(x-b)) * (fun x => splitScalarProduct m δ x) := rfl
  rw [hfun]
  rw [deriv_mul (by fun_prop : DifferentiableAt ℝ
    (fun x => (x-a)*(x-b)) r) hd]
  rw [hz]
  simp [a, b, r]

theorem splitScalarProduct_deriv_succ_new_first (m : ℕ) (δ : ℝ) :
    deriv (fun x => splitScalarProduct (m+1) δ x)
      (splitRoot δ (2*m+1)) =
      (splitRoot δ (2*m+1) - splitRoot δ (2*m+2)) *
        splitScalarProduct m δ (splitRoot δ (2*m+1)) := by
  let a := splitRoot δ (2*m+1)
  let b := splitRoot δ (2*m+2)
  have hd : DifferentiableAt ℝ (fun x => splitScalarProduct m δ x) a := by
    have heq : (fun x => splitScalarProduct m δ x) =
        fun x => ∏ i ∈ Finset.range (2*m+1), (x - splitRoot δ i) := by
      funext x
      exact splitScalarProduct_eq_prod_range m δ x
    rw [heq]
    fun_prop
  have hfun : (fun x => splitScalarProduct (m+1) δ x) =
      (fun x => x-a) *
        ((fun x => x-b) * (fun x => splitScalarProduct m δ x)) := by
    funext x
    simp [splitScalarProduct, a, b]
    ring
  rw [hfun, deriv_mul (by fun_prop : DifferentiableAt ℝ (fun x => x-a) a)
    ((by fun_prop : DifferentiableAt ℝ (fun x => x-b) a).mul hd)]
  simp [deriv_id'', a, b]

theorem splitScalarProduct_deriv_succ_new_second (m : ℕ) (δ : ℝ) :
    deriv (fun x => splitScalarProduct (m+1) δ x)
      (splitRoot δ (2*m+2)) =
      (splitRoot δ (2*m+2) - splitRoot δ (2*m+1)) *
        splitScalarProduct m δ (splitRoot δ (2*m+2)) := by
  let a := splitRoot δ (2*m+1)
  let b := splitRoot δ (2*m+2)
  have hd : DifferentiableAt ℝ (fun x => splitScalarProduct m δ x) b := by
    have heq : (fun x => splitScalarProduct m δ x) =
        fun x => ∏ i ∈ Finset.range (2*m+1), (x - splitRoot δ i) := by
      funext x
      exact splitScalarProduct_eq_prod_range m δ x
    rw [heq]
    fun_prop
  have hfun : (fun x => splitScalarProduct (m+1) δ x) =
      (fun x => x-b) *
        ((fun x => x-a) * (fun x => splitScalarProduct m δ x)) := by
    funext x
    simp [splitScalarProduct, a, b]
    ring
  rw [hfun, deriv_mul (by fun_prop : DifferentiableAt ℝ (fun x => x-b) b)
    ((by fun_prop : DifferentiableAt ℝ (fun x => x-a) b).mul hd)]
  simp [deriv_id'', a, b]

/-- The source scalar derivative alternates sign across the ordered split
roots: positive at even indices and negative at odd indices. -/
theorem splitScalarProduct_deriv_alternates (m : ℕ) {δ : ℝ}
    (hδ : 0 < δ) (j : ℕ) (hj : j < 2*m+1) :
    (Even j → 0 < deriv (fun x => splitScalarProduct m δ x) (splitRoot δ j)) ∧
    (Odd j → deriv (fun x => splitScalarProduct m δ x) (splitRoot δ j) < 0) := by
  induction m generalizing j with
  | zero =>
      have hj0 : j = 0 := by omega
      subst j
      constructor
      · intro _
        simp [splitScalarProduct]
      · intro ho
        rcases ho with ⟨k, hk⟩
        omega
  | succ m ih =>
      by_cases hold : j < 2*m+1
      · have hs := ih j hold
        rw [splitScalarProduct_deriv_succ_old m j δ hold]
        have hja : splitRoot δ j - splitRoot δ (2*m+1) < 0 :=
          sub_neg.mpr ((splitRoot_strictMono hδ) hold)
        have hjb : splitRoot δ j - splitRoot δ (2*m+2) < 0 :=
          sub_neg.mpr ((splitRoot_strictMono hδ) (by omega))
        have hfactor : 0 < (splitRoot δ j - splitRoot δ (2*m+1)) *
            (splitRoot δ j - splitRoot δ (2*m+2)) :=
          mul_pos_of_neg_of_neg hja hjb
        exact ⟨fun he => mul_pos hfactor (hs.1 he),
          fun ho => mul_neg_of_pos_of_neg hfactor (hs.2 ho)⟩
      · have hcases : j = 2*m+1 ∨ j = 2*m+2 := by omega
        rcases hcases with hfirst | hsecond
        · subst j
          rw [splitScalarProduct_deriv_succ_new_first]
          have hprev : splitRoot δ (2*m) < splitRoot δ (2*m+1) :=
            (splitRoot_strictMono hδ) (by omega)
          have hpos := splitScalarProduct_pos_above m hδ hprev
          have hgap : splitRoot δ (2*m+1) - splitRoot δ (2*m+2) < 0 :=
            sub_neg.mpr ((splitRoot_strictMono hδ) (by omega))
          constructor
          · intro he
            rcases he with ⟨k, hk⟩
            omega
          · intro _
            exact mul_neg_of_neg_of_pos hgap hpos
        · subst j
          rw [splitScalarProduct_deriv_succ_new_second]
          have hprev : splitRoot δ (2*m) < splitRoot δ (2*m+2) :=
            (splitRoot_strictMono hδ) (by omega)
          have hpos := splitScalarProduct_pos_above m hδ hprev
          have hgap : 0 < splitRoot δ (2*m+2) - splitRoot δ (2*m+1) :=
            sub_pos.mpr ((splitRoot_strictMono hδ) (by omega))
          constructor
          · intro _
            exact mul_pos hgap hpos
          · intro ho
            rcases ho with ⟨k, hk⟩
            omega

end
end PhosphorylationStableCapacity
