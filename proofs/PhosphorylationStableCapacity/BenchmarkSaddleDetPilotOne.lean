private theorem benchmarkSaddleOneDetE_lower :
    benchmarkSaddleOneDetE.IsLowerTriangular := by
  intro i j hij
  change i < j at hij
  fin_cases i <;> fin_cases j <;>
    norm_num [benchmarkSaddleOneDetE] at *

private theorem benchmarkSaddleOneDetT_upper :
    benchmarkSaddleOneDetT.IsUpperTriangular := by
  intro i j hij
  change j < i at hij
  fin_cases i <;> fin_cases j <;>
    norm_num [benchmarkSaddleOneDetT] at *

private theorem benchmarkSaddleOneDet_product :
    benchmarkSaddleOneDetE * benchmarkSaddleOneA.entries =
      benchmarkSaddleOneDetT := by
  ext i j
  rw [Matrix.mul_apply]
  fin_cases i <;> fin_cases j <;>
    norm_num [benchmarkSaddleOneDetE, benchmarkSaddleOneA,
      benchmarkSaddleOneDetT, Fin.sum_univ_succ]

private theorem benchmarkSaddleOneDetE_diagonal_positive :
    0 < ∏ i : Fin 9, benchmarkSaddleOneDetE i i := by
  norm_num [benchmarkSaddleOneDetE, Fin.prod_univ_succ]

private theorem benchmarkSaddleOneDetT_diagonal_positive :
    0 < ∏ i : Fin 9, benchmarkSaddleOneDetT i i := by
  norm_num [benchmarkSaddleOneDetT, Fin.prod_univ_succ]

